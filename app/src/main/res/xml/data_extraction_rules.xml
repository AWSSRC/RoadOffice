<?xml version="1.0" encoding="utf-8"?>
<!-- 보안 가이드: 민감 데이터(운행·고객 DB)는 백업·기기 이전 대상에서 제외 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
