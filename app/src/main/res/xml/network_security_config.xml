<?xml version="1.0" encoding="utf-8"?>
<!-- 보안 가이드: 외부 통신은 HTTPS 만 (평문 HTTP 차단), 사용자 추가 인증서 신뢰 안 함 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
