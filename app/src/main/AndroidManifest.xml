<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK: 주행거리·기어(CAR_DRIVE), 배터리 SOC·연료(CAR_ENERGY, 주유·충전 포착) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Pleos Vehicle SDK: 좌석 점유 (동승자 보호·미팅 후 착석 시 회고) — 조회만, 좌석 제어 권한은 쓰지 않음 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Pleos NaviHelper: 경로·도착·트립 정보 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- AAOS 표준: 차량 속도 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- Pleos FusedLocation: 출발·도착 위치, 거래처 인식 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Pleos 음성: 미팅 후 회고(STT), 브리핑(TTS) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pleos LLM(기기 내장): 상담 일지 정리 -->
    <uses-permission android:name="pleos.car.permission.LLM_SERVICE" />

    <application
        android:name=".RoadOfficeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- AAOS 주행 중 화면 제한: 주행 중엔 조작 없는 한 줄 상태만 보여 주므로 주행 중 표시 허용 선언 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Gleo Interface: assets/schema.json 의 function 을 Gleo AI 가 broadcast 로 호출 -->
        <receiver
            android:name=".gleo.GleoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="MARK_TRIP_PURPOSE" />
                <action android:name="ADD_MEETING_NOTE" />
                <action android:name="GET_CLIENT_BRIEFING" />
                <action android:name="ASK_ROADOFFICE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
